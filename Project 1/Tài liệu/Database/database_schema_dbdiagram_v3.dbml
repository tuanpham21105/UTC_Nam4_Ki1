// ============================================================================
// Website quản lý bài tập & chấm chữa bài tiếng Anh thông minh — Group 4
// BẢN V3 — dựa trên V2 FINAL, đã áp dụng theo "Review Database — Nhóm 4"
// (bản review ngày 10/09/2026) + trả lời nghiệp vụ (review_database_v2_business_question.md):
//
// NGHIÊM TRỌNG (1-4):
//   - Fix #1 (answers UNIQUE vô hiệu khi question_id NULL)      -> ĐÃ SỬA
//   - Fix #2a (correct_answer vs question_options.is_correct)   -> ĐÃ SỬA (CHECK ở Note)
//   - Fix #2b (trigger đúng 1 is_correct=true / question)       -> ĐÃ CHỐT: KHÔNG thêm trigger/CHECK này
//     (business: câu hỏi dạng checkbox có thể có nhiều đáp án đúng, dạng radio chỉ 1 -> ràng buộc "đúng 1"
//     là sai với checkbox nên không áp dụng chung cho mọi MULTIPLE_CHOICE)
//   - Fix #3 (classes.status thiếu NOT NULL + DEFAULT)          -> ĐÃ SỬA
//   - Fix #4 (gradings.method AUTO mâu thuẫn note final_score)  -> ĐÃ SỬA note theo chốt nghiệp vụ:
//     AUTO chỉ áp dụng Reading/Listening (điểm cộng tự động từ answer_results, giáo viên chỉ duyệt);
//     TEACHER_MANUAL giáo viên tự nhập điểm.
//
// THIẾU RÀNG BUỘC (5-8) — đã bổ sung dạng Note (DBML không có cú pháp CHECK thật):
//   - #5 class_members: +CHECK (status='ACTIVE' OR ended_at IS NOT NULL)
//   - #6 question_options: +UNIQUE(question_id, order_index)
//   - #7 gradings: +CHECK (final_score >= 0 AND final_score <= max_score_snapshot)
//   - #8 assignments.max_submissions, modules.max_score: +CHECK > 0 (khi NOT NULL)
//
// RỦI RO THIẾT KẾ (9-13) — theo chốt nghiệp vụ:
//   - #9  assignments: ĐÃ BỎ cột is_manually_closed, chỉ còn duy nhất status làm nguồn sự thật.
//   - #10 teacher_profiles/student_profiles không ràng buộc theo role -> CHƯA CÓ câu trả lời nghiệp vụ,
//     giữ nguyên schema, xem danh sách câu hỏi cần xác nhận.
//   - #11 assignments.teacher_id PHẢI trùng classes.teacher_id hiện tại (chốt: chỉ giáo viên đang giao bài
//     mới được chấm) -> đã ghi rõ business rule ở Note; CƠ CHẾ ENFORCE (trigger DB hay service layer)
//     CHƯA CHỐT, xem danh sách câu hỏi.
//   - #12 soft-delete vs hard-delete: XÁC NHẬN giữ nguyên như V2 — cascade cứng cho classes/modules/
//     questions/submissions/gradings/question_options/submission_modules/answers/answer_results/
//     answer_annotations; soft-delete (is_deleted) chỉ cho users và assignments. Không đổi FK nào.
//   - #13 answer_annotations.review_status: XÁC NHẬN default PENDING bất kể source — không đổi DB,
//     source=TEACHER tự động ACCEPTED được xử lý ở service layer (không sửa schema).
//
// 18 bảng (17 V1 + question_options + answer_results − criteria_scores)
// Paste toàn bộ vào https://dbdiagram.io để xem ERD
// ============================================================================

Enum user_role {
  ADMIN
  TEACHER
  STUDENT
}

Enum user_status {
  ACTIVE
  LOCKED
}

Enum class_status {
  ACTIVE
  INACTIVE
  COMPLETED
  CANCELLED
}

Enum class_member_type {
  PRIMARY
  SUPPLEMENTARY
}

Enum class_member_status {
  ACTIVE
  ENDED
}

Enum assignment_status {
  DRAFT
  PUBLISHED
  CLOSED
}

Enum module_skill {
  READING
  LISTENING
  WRITING
  SPEAKING
}

Enum module_task_type {
  QUIZ
  REWRITE
  RECORDING
  ESSAY
}

Enum upload_status {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

Enum question_type {
  MULTIPLE_CHOICE
  SHORT_ANSWER
}

Enum submission_status {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

Enum annotation_source {
  AI
  TEACHER
}

Enum review_status {
  PENDING
  ACCEPTED
  REJECTED
}

// V2: bỏ giá trị AI — AI không tự chấm điểm, chỉ chỉ lỗi + nhận xét text
Enum grading_method {
  AUTO
  TEACHER_MANUAL
}

// V2: +AI_GRADED — "AI đã phân tích/chú thích xong, chờ giáo viên chấm"
Enum grading_status {
  PENDING
  AI_GRADED
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// 1. USERS
// ---------------------------------------------------------------------------

Table users {
  id bigint [pk, increment]
  full_name varchar(150) [not null]
  email varchar(150) [not null, unique]
  phone varchar(20)
  avatar_url varchar(255)
  password_hash varchar(255) [not null]
  role user_role [not null]
  status user_status [not null, default: 'ACTIVE']
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    role [name: 'idx_users_role']
    status [name: 'idx_users_status']
  }
}

// ---------------------------------------------------------------------------
// 2. TEACHER PROFILES
// ---------------------------------------------------------------------------

Table teacher_profiles {
  user_id bigint [pk]
  specialization varchar(150)

  Note: 'V3 (review RỦI RO #10, chốt nghiệp vụ): review nêu không có ràng buộc đảm bảo user tạo profile đúng role (users.role) và không bị insert vào cả 2 bảng teacher_profiles/student_profiles. Chốt: KHÔNG thêm CHECK/trigger kiểm tra chéo trong DB — xử lý validate role ở SERVICE LAYER khi tạo profile. Không đổi schema.'
}

// ---------------------------------------------------------------------------
// 3. STUDENT PROFILES
// ---------------------------------------------------------------------------

Table student_profiles {
  user_id bigint [pk]
  student_code varchar(30) [unique]
  date_of_birth date
  parent_phone varchar(20)
}

// ---------------------------------------------------------------------------
// 4. CLASSES  [V2: status đổi VARCHAR(20) -> ENUM class_status, BUG_DB_10]
// [V3 fix review NGHIÊM TRỌNG #3: status thêm NOT NULL + DEFAULT 'ACTIVE']
// ---------------------------------------------------------------------------

Table classes {
  id bigint [pk, increment]
  name varchar(150) [not null]
  level varchar(50)
  description text
  start_date date [not null]
  end_date date
  status class_status [not null, default: 'ACTIVE']
  teacher_id bigint
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    teacher_id [name: 'idx_classes_teacher_id']
  }
}

// ---------------------------------------------------------------------------
// 5. CLASS MEMBERS  [V2: +ended_at, UNIQUE -> partial unique WHERE ACTIVE]
// ---------------------------------------------------------------------------

Table class_members {
  id bigint [pk, increment]
  class_id bigint [not null]
  student_id bigint [not null]
  member_type class_member_type [not null]
  status class_member_status [not null, default: 'ACTIVE']
  ended_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    class_id [name: 'idx_class_members_class_id']
    student_id [name: 'idx_class_members_student_id']
    // V1 constraint uq_class_members_class_student (UNIQUE cứng) đã bị DROP ở V2.
    // Thay bằng 2 partial unique index (không biểu diễn được trực tiếp trong DBML):
    // CREATE UNIQUE INDEX uq_class_members_active_class_student
    //   ON class_members (class_id, student_id) WHERE status = 'ACTIVE';         -- [MỚI V2, fix BUG_DB_15]
    // CREATE UNIQUE INDEX uq_class_members_one_active_primary_per_student
    //   ON class_members (student_id) WHERE member_type = 'PRIMARY' AND status = 'ACTIVE'; -- (giữ từ V1)
  }

  Note: 'V2: ended_at lưu thời điểm rời lớp (BUG_DB_16). UNIQUE(class_id, student_id) cũ đổi thành partial index chỉ áp dụng khi status=ACTIVE, cho phép học lại lớp sau khi ENDED (BUG_DB_15). V3 fix (review THIẾU RÀNG BUỘC #5): +CHECK (status = ACTIVE OR ended_at IS NOT NULL) — cùng pattern với submissions, tránh học viên ENDED mà không có mốc thời gian rời lớp.'
}

// ---------------------------------------------------------------------------
// 6. ASSIGNMENTS  [V2: +status enum DRAFT/PUBLISHED/CLOSED, BUG_DB_09]
// ---------------------------------------------------------------------------

Table assignments {
  id bigint [pk, increment]
  class_id bigint [not null]
  teacher_id bigint [not null]
  title varchar(200) [not null]
  description text
  open_at timestamptz [not null]
  close_at timestamptz [not null]
  max_submissions int
  status assignment_status [not null, default: 'DRAFT']
  is_deleted boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    class_id [name: 'idx_assignments_class_id']
    teacher_id [name: 'idx_assignments_teacher_id']
  }

  Note: 'CHECK (open_at < close_at). V3 fix (review RỦI RO #9, chốt nghiệp vụ): ĐÃ BỎ cột is_manually_closed để tránh 2 nguồn xác định "bài có đang mở không" bị lệch nhau — status (DRAFT/PUBLISHED/CLOSED) là nguồn sự thật DUY NHẤT. V3 fix (review THIẾU RÀNG BUỘC #8): +CHECK (max_submissions > 0) khi NOT NULL. V3 (review RỦI RO #11, chốt nghiệp vụ): teacher_id BẮT BUỘC trùng classes.teacher_id hiện tại — chỉ giáo viên đang phụ trách lớp mới được giao/chấm bài. Chốt: KHÔNG dùng trigger DB — validate ở SERVICE LAYER tại thời điểm tạo/cập nhật assignment. Không đổi schema/FK.'
}

// ---------------------------------------------------------------------------
// 7. MODULES  [V2: +ai_instruction — hướng dẫn/prompt giáo viên viết cho AI]
// ---------------------------------------------------------------------------

Table modules {
  id bigint [pk, increment]
  assignment_id bigint [not null]
  skill module_skill [not null]
  task_type module_task_type [not null]
  order_index int [not null]
  instructions text
  ai_instruction text
  max_score decimal(5,2) [not null, default: 10]
  source_audio_storage_key varchar(255)
  source_audio_duration_seconds int
  source_audio_mime_type varchar(50)
  source_audio_upload_status upload_status

  indexes {
    assignment_id [name: 'idx_modules_assignment_id']
    (assignment_id, order_index) [unique, name: 'uq_modules_assignment_order']
  }

  Note: 'ai_instruction: prompt tự do giáo viên viết cho AI chấm (không phải rubric cố định). Nullable. V3 fix (review THIẾU RÀNG BUỘC #8): +CHECK (max_score > 0) — đồng bộ với questions.score đã có CHECK >= 0.'
}

// ---------------------------------------------------------------------------
// 8. QUESTIONS
// ---------------------------------------------------------------------------

Table questions {
  id bigint [pk, increment]
  module_id bigint [not null]
  content text [not null]
  question_type question_type [not null]
  correct_answer text
  score decimal(5,2) [not null, default: 1]
  order_index int [not null]

  indexes {
    module_id [name: 'idx_questions_module_id']
    (module_id, order_index) [unique, name: 'uq_questions_module_order']
  }

  Note: 'CHECK (score >= 0) — BUG_DB_06. V3 fix (review NGHIÊM TRỌNG #2, phần a): +CHECK (question_type = MULTIPLE_CHOICE AND correct_answer IS NULL) OR (question_type = SHORT_ANSWER) — đảm bảo correct_answer chỉ được phép NOT NULL khi question_type = SHORT_ANSWER; với MULTIPLE_CHOICE bắt buộc NULL (đáp án đúng của MULTIPLE_CHOICE lấy từ question_options.is_correct). Phần (b), chốt nghiệp vụ: KHÔNG thêm trigger/CHECK ép đúng 1 dòng is_correct=true trên mỗi question, vì MULTIPLE_CHOICE dạng checkbox (multi-select) hợp lệ có nhiều đáp án đúng, chỉ dạng radio (single-select) mới có đúng 1. Chốt tiếp: question_type = MULTIPLE_CHOICE là NHÃN CHUNG để đánh dấu câu hỏi dùng đáp án trắc nghiệm (qua question_options), KHÔNG cần thêm cột phân biệt single-select/multi-select — không đổi schema.'
}

// ---------------------------------------------------------------------------
// 9. QUESTION OPTIONS  [MỚI V2 — fix BUG_DB_01, Blocker]
// ---------------------------------------------------------------------------

Table question_options {
  id bigint [pk, increment]
  question_id bigint [not null]
  content text [not null]
  is_correct boolean [not null, default: false]
  order_index int [not null]

  indexes {
    question_id [name: 'idx_question_options_question_id']
    (question_id, order_index) [unique, name: 'uq_question_options_question_order']
  }

  Note: 'Lựa chọn A/B/C/D cho questions.question_type = MULTIPLE_CHOICE. V3 fix (review THIẾU RÀNG BUỘC #6): +UNIQUE(question_id, order_index) — cùng pattern với questions/modules, tránh trùng thứ tự A/B/C/D trong cùng 1 câu hỏi.'
}

// ---------------------------------------------------------------------------
// 10. SUBMISSIONS
// ---------------------------------------------------------------------------

Table submissions {
  id bigint [pk, increment]
  assignment_id bigint [not null]
  student_id bigint [not null]
  attempt_number int [not null]
  submitted_at timestamptz
  status submission_status [not null, default: 'IN_PROGRESS']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    assignment_id [name: 'idx_submissions_assignment_id']
    student_id [name: 'idx_submissions_student_id']
    (assignment_id, student_id, attempt_number) [unique, name: 'uq_submissions_assignment_student_attempt']
  }

  Note: 'V2: +CHECK (status=IN_PROGRESS OR submitted_at NOT NULL), +CHECK (attempt_number > 0) — BUG_DB_13, BUG_DB_06.'
}

// ---------------------------------------------------------------------------
// 11. SUBMISSION MODULES
// ---------------------------------------------------------------------------

Table submission_modules {
  id bigint [pk, increment]
  submission_id bigint [not null]
  module_id bigint [not null]
  status submission_status [not null, default: 'IN_PROGRESS']
  audio_play_count int [not null, default: 0]

  indexes {
    submission_id [name: 'idx_submission_modules_submission_id']
    module_id [name: 'idx_submission_modules_module_id']
    (submission_id, module_id) [unique, name: 'uq_submission_modules_submission_module']
  }
}

// ---------------------------------------------------------------------------
// 12. ANSWERS  [V2: +UNIQUE(submission_module_id, question_id), +CHECK]
// ---------------------------------------------------------------------------

Table answers {
  id bigint [pk, increment]
  submission_module_id bigint [not null]
  question_id bigint
  content text
  audio_storage_key varchar(255)
  audio_duration_seconds int
  audio_file_size_bytes bigint
  audio_mime_type varchar(50)
  audio_upload_status upload_status
  doc_storage_key varchar(255)
  doc_mime_type varchar(50)
  doc_file_size_bytes bigint
  doc_upload_status upload_status
  created_at timestamptz [not null, default: `now()`]

  indexes {
    submission_module_id [name: 'idx_answers_submission_module_id']
    question_id [name: 'idx_answers_question_id']
    // V3 fix (review NGHIÊM TRỌNG #1): UNIQUE cứng (submission_module_id, question_id) của V2 bị DROP vì
    // PostgreSQL coi NULL <> NULL nên constraint đó vô hiệu với Writing/Speaking (question_id luôn NULL).
    // Thay bằng 2 partial unique index (không biểu diễn được trực tiếp trong DBML), cần tạo qua SQL riêng:
    // CREATE UNIQUE INDEX uq_answers_submodule_question ON answers (submission_module_id, question_id)
    //   WHERE question_id IS NOT NULL;                            -- case Reading/Listening (có quiz)
    // CREATE UNIQUE INDEX uq_answers_submodule_no_question ON answers (submission_module_id)
    //   WHERE question_id IS NULL;                                -- case Writing/Speaking (không quiz)
  }

  Note: 'Ràng buộc "đúng 1 trong 3 nguồn dữ liệu" (content/audio/doc) xử lý ở service layer. V3: SỬA constraint chặn spam-submit (BUG_DB_05) — xem 2 partial unique index ở mục indexes — để có tác dụng với cả case question_id NULL (Writing/Speaking), không chỉ Reading/Listening như V2. +CHECK audio_duration_seconds >= 0, audio_file_size_bytes >= 0 (BUG_DB_06).'
}

// ---------------------------------------------------------------------------
// 13. ANSWER RESULTS  [MỚI V2 — fix BUG_DB_04, Blocker]
// ---------------------------------------------------------------------------

Table answer_results {
  id bigint [pk, increment]
  answer_id bigint [not null, unique]
  is_correct boolean [not null]
  score decimal(5,2) [not null]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Kết quả chấm tự động từng câu (Reading/Listening). 1-1 với answers. CHECK (score >= 0).'
}

// ---------------------------------------------------------------------------
// 14. ANSWER ANNOTATIONS
// ---------------------------------------------------------------------------

Table answer_annotations {
  id bigint [pk, increment]
  answer_id bigint [not null]
  source annotation_source [not null]
  start_offset int [not null]
  end_offset int [not null]
  error_type varchar(50)
  comment text
  suggested_fix text
  review_status review_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    answer_id [name: 'idx_answer_annotations_answer_id']
  }

  Note: 'CHECK (end_offset >= start_offset). Đây là nơi AI chỉ lỗi (source=AI) — vai trò AI duy nhất, không tự chấm điểm. V3 (review RỦI RO #13, chốt nghiệp vụ): GIỮ NGUYÊN default review_status = PENDING bất kể source (không đổi DB). Trường hợp source=TEACHER tự động chuyển ACCEPTED được xử lý ở SERVICE LAYER khi insert, đúng như đề xuất ban đầu của review — không thêm logic vào DB.'
}

// ---------------------------------------------------------------------------
// 15. GRADINGS  [V2: -ai_suggested_score, -plagiarism (2 cột), +ai_transcript, +ai_instruction_snapshot]
// ---------------------------------------------------------------------------

Table gradings {
  id bigint [pk, increment]
  submission_module_id bigint [not null, unique]
  method grading_method [not null]
  status grading_status [not null, default: 'PENDING']
  ai_feedback text
  ai_transcript jsonb
  ai_instruction_snapshot text
  final_score decimal(5,2)
  final_feedback text
  max_score_snapshot decimal(5,2)
  reviewed_by bigint
  reviewed_at timestamptz
  graded_at timestamptz

  indexes {
    reviewed_by [name: 'idx_gradings_reviewed_by']
    status [name: 'idx_gradings_status']
  }

  Note: 'V2: DROP ai_suggested_score, is_plagiarism_flagged, plagiarism_score (AI không tự chấm điểm, chưa build đạo văn). +ai_transcript (jsonb, Speaking), +ai_instruction_snapshot (chốt modules.ai_instruction lúc chấm). V3 fix (review NGHIÊM TRỌNG #4, chốt nghiệp vụ): SỬA lại note cũ "final_score luôn do giáo viên nhập" vì sai với method=AUTO. Ngữ nghĩa đúng: method=AUTO áp dụng cho Reading/Listening — final_score được CỘNG TỰ ĐỘNG từ answer_results, giáo viên chỉ DUYỆT (không gõ tay); method=TEACHER_MANUAL (Writing/Speaking) — giáo viên tự nhập final_score. V3 fix (review THIẾU RÀNG BUỘC #7): +CHECK (final_score >= 0 AND final_score <= max_score_snapshot).'
}

// ---------------------------------------------------------------------------
// 16. REFRESH TOKENS
// ---------------------------------------------------------------------------

Table refresh_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  user_agent varchar(255)
  ip_address varchar(45)
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_refresh_tokens_user_id']
    (user_id, expires_at) [name: 'idx_refresh_tokens_active']
    // Partial index WHERE revoked_at IS NULL — not representable in DBML syntax.
  }
}

// ---------------------------------------------------------------------------
// 17. STUDENT EVALUATIONS
// ---------------------------------------------------------------------------

Table student_evaluations {
  id bigint [pk, increment]
  student_id bigint [not null]
  teacher_id bigint [not null]
  class_id bigint [not null]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    student_id [name: 'idx_student_evaluations_student_id']
    teacher_id [name: 'idx_student_evaluations_teacher_id']
    class_id [name: 'idx_student_evaluations_class_id']
  }
}

// ---------------------------------------------------------------------------
// 18. GRADING CHANGE LOGS
// ---------------------------------------------------------------------------

Table grading_change_logs {
  id bigint [pk, increment]
  grading_id bigint [not null]
  changed_by bigint [not null]
  old_score decimal(5,2)
  new_score decimal(5,2)
  note text
  changed_at timestamptz [not null, default: `now()`]

  indexes {
    (grading_id, changed_at) [name: 'idx_grading_change_logs_grading_id_changed_at']
    changed_by [name: 'idx_grading_change_logs_changed_by']
  }
}

// ---------------------------------------------------------------------------
// RELATIONSHIPS (Foreign Keys)
// criteria_scores.grading_id > gradings.id đã bị xóa cùng bảng criteria_scores (V2)
// ---------------------------------------------------------------------------

Ref: teacher_profiles.user_id - users.id
Ref: student_profiles.user_id - users.id

Ref: classes.teacher_id > teacher_profiles.user_id

Ref: class_members.class_id > classes.id
Ref: class_members.student_id > student_profiles.user_id

Ref: assignments.class_id > classes.id
Ref: assignments.teacher_id > teacher_profiles.user_id

Ref: modules.assignment_id > assignments.id [delete: cascade]

Ref: questions.module_id > modules.id [delete: cascade]

Ref: question_options.question_id > questions.id [delete: cascade]

Ref: submissions.assignment_id > assignments.id
Ref: submissions.student_id > student_profiles.user_id

Ref: submission_modules.submission_id > submissions.id [delete: cascade]
Ref: submission_modules.module_id > modules.id

Ref: answers.submission_module_id > submission_modules.id [delete: cascade]
Ref: answers.question_id > questions.id

Ref: answer_results.answer_id - answers.id [delete: cascade]

Ref: answer_annotations.answer_id > answers.id [delete: cascade]

Ref: gradings.submission_module_id - submission_modules.id [delete: cascade]
Ref: gradings.reviewed_by > teacher_profiles.user_id

Ref: refresh_tokens.user_id > users.id

Ref: student_evaluations.student_id > student_profiles.user_id
Ref: student_evaluations.teacher_id > teacher_profiles.user_id
